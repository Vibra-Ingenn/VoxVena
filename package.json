{
  "name": "vox-vena",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Vox Vena — local app that rewrites AI-sounding text into natural human prose",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
